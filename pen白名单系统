-- ==================== BILLBOARD GUI ESP (名称/生命值/距离) ====================
local function createBillboardGui(player, character)
    if player == LocalPlayer then return end
    if not (player.Character and player.Character:FindFirstChild("Head")) then return end
    if billboardCache[player] then return end
    
    local head = player.Character.Head
    local bgui = Instance.new("BillboardGui")
    bgui.Name = "ESP_Billboard"
    bgui.Adornee = head
    bgui.MaxDistance = math.huge
    bgui.Size = UDim2.new(4, 0, 2, 0)
    bgui.StudsOffset = Vector3.new(0, 3, 0)
    
    local frame = Instance.new("Frame", bgui)
    frame.BackgroundTransparency = 1
    frame.Size = UDim2.new(1, 0, 1, 0)
    
    local textLabel = Instance.new("TextLabel", frame)
    textLabel.BackgroundTransparency = 1
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextSize = 14
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextStrokeTransparency = 0.5
    
    bgui.Parent = head
    billboardCache[player] = { bgui = bgui, label = textLabel, head = head }
end

local function updateBillboardText(player)
    if not billboardCache[player] then return end
    if not player.Parent or not player.Character then 
        pcall(function() billboardCache[player].bgui:Destroy() end)
        billboardCache[player] = nil
        return 
    end
    
    local label = billboardCache[player].label
    local character = player.Character
    local humanoid = character:FindFirstChild("Humanoid")
    
    local parts = {}
    if ESP_Name then table.insert(parts, player.Name) end
    if ESP_Health and humanoid then table.insert(parts, string.format("%.0f HP", humanoid.Health)) end
    if ESP_Distance and character:FindFirstChild("HumanoidRootPart") then
        local dist = (LocalPlayer.Character.HumanoidRootPart.Position - character.HumanoidRootPart.Position).Magnitude
        table.insert(parts, string.format("%.1f m", dist))
    end
    
    label.Text = table.concat(parts, " | ")
end

