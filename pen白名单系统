-- ==================== TRACER ESP (射线透视 - Beam) ====================
local function createTracerBeam(player)
    if player == LocalPlayer then return end
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    if beamCache[player] then return end
    
    local localRoot = LocalPlayer.Character.HumanoidRootPart
    
    -- Create attachments
    local attach1 = Instance.new("Attachment")
    attach1.Parent = localRoot
    
    local charRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not charRoot then return end
    
    local attach2 = Instance.new("Attachment")
    attach2.Parent = charRoot
    
    -- Create beam
    local beam = Instance.new("Beam")
    beam.Attachment0 = attach1
    beam.Attachment1 = attach2
    beam.Color = ColorSequence.new(Color3.fromRGB(0, 100, 255))
    beam.Transparency = NumberSequence.new(0.3)
    beam.Width0 = 0.1
    beam.Width1 = 0.1
    beam.Parent = localRoot
    
    beamCache[player] = { beam = beam, attach1 = attach1, attach2 = attach2 }
end

local function removeTracerBeam(player)
    if beamCache[player] then
        pcall(function() beamCache[player].beam:Destroy() end)
        pcall(function() beamCache[player].attach1:Destroy() end)
        pcall(function() beamCache[player].attach2:Destroy() end)
        beamCache[player] = nil
    end
end

-- ==================== 增强的墙体检测函数 ====================
local function isPlayerVisible(targetPlayer)
    if not WallCheck then return true end -- 如果墙体检测关闭，总是返回可见
    
    if not targetPlayer.Character or not targetPlayer:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local targetRoot = targetPlayer.Character.HumanoidRootPart
    local cameraPos = Camera.CFrame.Position
    
    -- 创建射线检测是否有障碍物
    local rayDirection = (targetRoot.Position - cameraPos).Unit * (targetRoot.Position - cameraPos).Magnitude
    local ray = Ray.new(cameraPos, rayDirection)
    
    -- 忽略列表：排除自己和目标玩家
    local ignoreList = {LocalPlayer.Character, targetPlayer.Character}
    
    local hit, hitPosition = game.Workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
    
    -- 如果射线没有击中任何东西或者击中的是目标玩家，则玩家可见
    if not hit or hit.Parent == targetPlayer.Character then
        return true
    end
    
    -- 检查距离：如果障碍物在目标玩家前面太近，则不可见
    local distanceToObstacle = (hitPosition - cameraPos).Magnitude
    local distanceToTarget = (targetRoot.Position - cameraPos).Magnitude
    
    -- 如果障碍物比目标玩家更近，则被挡住
    return distanceToObstacle > distanceToTarget - 5 -- 5Studs容错距离
end

-- ==================== 自瞄目标查找函数 ====================
local function findAimbotTarget()
    local maxangle = math.rad(20)
    local bestTarget = nil
    
    for i, plr in pairs(Players:GetPlayers()) do
        if plr.Name ~= LocalPlayer.Name and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 1 then
            
            -- 队伍检测逻辑
            local canTarget = true
            if TeamBased and plr.Team and LocalPlayer.Team then
                canTarget = (plr.Team.Name ~= LocalPlayer.Team.Name)
            end
            
            if canTarget then
                -- 墙体检测逻辑
                if WallCheck then
                    if isPlayerVisible(plr) then
                        local an = checkfov(plr.Character.Head)
                        if an < maxangle then
                            maxangle = an
                            bestTarget = plr.Character.Head
                        end
                    end
                else
                    -- 如果墙体检测关闭，直接瞄准
                    local an = checkfov(plr.Character.Head)
                    if an < maxangle then
                        maxangle = an
                        bestTarget = plr.Character.Head
                    end
                end
            end
            
            if bestTarget and plr.Character:FindFirstChild("Humanoid") then
                local old = bestTarget
                plr.Character.Humanoid.Died:Connect(function()
                    if aimatpart and aimatpart == old then
                        aimatpart = nil
                    end
                end)
            end
        end
    end
    
    return bestTarget
end

