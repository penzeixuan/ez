function updateHighlights()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            
            -- 更新Billboard
            if (ESP_Name or ESP_Health or ESP_Distance) and character then
                createBillboardGui(player, character)
                updateBillboardText(player)
            elseif billboardCache[player] then
                pcall(function() billboardCache[player].bgui:Destroy() end)
                billboardCache[player] = nil
            end
            
            -- 更新Highlight/Outline
            if ESP_Outline and character then
                createHighlight(player, character)
            elseif highlightCache[player] then
                removeHighlight(player)
            end
            
            -- 更新Tracer
            if ESP_Tracer and character then
                createTracerBeam(player)
            elseif beamCache[player] then
                removeTracerBeam(player)
            end
        end
    end
end

-- ==================== 自瞄功能 ====================
local function getfovxyz (p0, p1, deg)
    local x1, y1, z1 = p0:ToOrientation()
    local cf = CFrame.new(p0.p, p1.p)
    local x2, y2, z2 = cf:ToOrientation()
    local d = math.deg
    if deg then
        return Vector3.new(d(x1-x2), d(y1-y2), d(z1-z2))
    else
        return Vector3.new((x1-x2), (y1-y2), (z1-z2))
    end
end

function checkfov (part)
    local fov = getfovxyz(Camera.CFrame, part.CFrame)
    local angle = math.abs(fov.X) + math.abs(fov.Y)
    return angle
end

function aimat(part)
    if part then
        local d = (Camera.CFrame.p - part.CFrame.p).magnitude
        local calculatedrop
        local timetoaim = 0
        local pos2 = Vector3.new()
        if movementcounting == true then
            timetoaim = d/3584
            pos2 = part.Velocity * timetoaim
        end
        local minuseddrop = 1
        local cf = CFrame.new(Camera.CFrame.p, (pos2 + part.CFrame.p+ Vector3.new(0, calculatedrop, 0)))
        if aimbothider == true or Aim_Assist == true then
            Camera.CFrame = Camera.CFrame:Lerp(cf, aimbothiderspeed)
        else
            Camera.CFrame = cf
        end
    end
end

